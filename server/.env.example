# Azure Database for PostgreSQL Flexible Server
# Copy this file to .env and replace every placeholder.
DATABASE_URL=postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/<database>

# Keep this secret outside source control.
JWT_SECRET=<long-random-secret>

# Optional API settings
PORT=5000
AI_SERVICE_URL=http://localhost:8000

# Optional connection-pool setting
DB_POOL_MAX=10
